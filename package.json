{
  "name": "sayio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5290",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ses:topla": "esbuild scripts/voice/collect.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-collect.mjs --log-level=error && node node_modules/.cache/sayio-collect.mjs",
    "ses:sesler": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/generate.mjs --voices",
    "ses:ornek": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/generate.mjs --sample 12",
    "ses:uret": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/generate.mjs",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --splashBackgroundColor #cfeee6 --splashBackgroundColorDark #123b36 --iconBackgroundColor #ff6b4a --iconBackgroundColorDark #ff6b4a",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "sync": "npm run build && cap sync",
    "ses:dene": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/demo.mjs",
    "ses:temizle": "rm -rf public/voice",
    "ses:denetle": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/audit.mjs",
    "ses:sec": "esbuild src/lib/voiceText.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sayio-voicetext.mjs --log-level=error && node scripts/voice/audition.mjs",
    "magaza:ekran": "tsx scripts/store-shots.mts",
    "magaza:gorsel": "tsx scripts/store-promo.mts",
    "yatay:kontrol": "tsx scripts/landscape-check.mts"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
